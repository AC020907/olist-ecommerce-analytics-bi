// =============================================================================
// measure_fixes.dax -- change log for docs/TECHNICAL_AUDIT.md findings A-01, A-02, A-08
//
// Applied to olist_business_intelligence.pbix on 2026-10-29 through the Power BI
// modeling MCP server (Tabular Object Model), data refreshed, saved from Power BI
// Desktop and verified after closing and reopening the file.
// These are the exact expressions now stored in the model's _Measures table.
//
// Before -> after, full dataset (data imported under the calendar-date late rule):
//   Avg Review Score On-Time   4.2148 -> 4.29   (BLANK() = FALSE() counted 2,873 orders
//                                                without a delivery outcome as on-time)
//   Avg Review Score Late      2.5662 -> 2.27   (late rule now compares calendar dates)
//   Late Delivery %            8.11%  -> 6.77%  (rule + denominator = measurable deliveries)
//   Total Freight              2,251,909.54 -> 2,241,126.29 (valid orders only)
//   Freight % of Revenue       16.69% -> 16.61%
//   Item Revenue/Seller Rev.   13,591,643.70 -> 13,494,400.74 (= Net Revenue)
//   Items Sold                 112,650 -> 112,101
//   Avg Items per Order        1.147  -> 1.141  (numerator was all statuses)
// =============================================================================

Avg Review Score On-Time =
// Strict == so orders without a delivery outcome (is_late BLANK) are not counted as on-time.
CALCULATE(
    [Avg Review Score],
    'analytics fact_orders'[is_late] == FALSE()
)

Avg Review Score Late =
CALCULATE(
    [Avg Review Score],
    'analytics fact_orders'[is_late] == TRUE()
)

Late Delivery % =
// Denominator: delivered orders with valid dates (is_late not blank), same as SQL.
DIVIDE(
    CALCULATE(
        COUNTROWS('analytics fact_orders'),
        'analytics fact_orders'[is_late] == TRUE()
    ),
    CALCULATE(
        COUNTROWS('analytics fact_orders'),
        NOT ISBLANK('analytics fact_orders'[is_late])
    )
)

Total Freight =
CALCULATE(
    SUM('analytics fact_orders'[freight_total]),
    'analytics fact_orders'[order_status] <> "canceled",
    'analytics fact_orders'[order_status] <> "unavailable"
)

Avg Items per Order =
DIVIDE(
    CALCULATE(
        SUM('analytics fact_orders'[n_items]),
        'analytics fact_orders'[order_status] <> "canceled",
        'analytics fact_orders'[order_status] <> "unavailable"
    ),
    [Total Orders]
)

Item Revenue =
CALCULATE(
    SUM('analytics fact_order_items'[price]),
    'analytics fact_order_items'[order_status] <> "canceled",
    'analytics fact_order_items'[order_status] <> "unavailable"
)

Items Sold =
CALCULATE(
    COUNTROWS('analytics fact_order_items'),
    'analytics fact_order_items'[order_status] <> "canceled",
    'analytics fact_order_items'[order_status] <> "unavailable"
)

Avg Item Price = DIVIDE([Item Revenue], [Items Sold])

Seller Revenue = [Item Revenue]
