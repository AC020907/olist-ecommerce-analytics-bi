# Raw data is not committed: it's 126MB+ and publicly available on Kaggle.
# See data/README.md for the exact source and how to reproduce data/raw/.
data/raw/*.csv

# Regenerable Power BI import CSVs (58MB) -- rebuild with
# scripts/export_model_for_powerbi.sql. Not committed for the same reason
# as data/raw/: it's a derived artifact, not source.
powerbi/model_export/*.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor noise
.DS_Store
.vscode/
*.swp

# Power BI local cache (not the .pbix itself, which we do want to version)
*.pbix.bak
