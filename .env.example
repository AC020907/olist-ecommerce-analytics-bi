# Copy to .env (never commit .env). Read by python -m olist_bi and docker compose.
# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olist_analytics

# ...or the standard libpq variables (also honoured by psql and Power BI's connector docs).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=olist_analytics

# Optional: folder with the 9 Olist CSVs (defaults to data/raw).
# OLIST_DATA_DIR=data/raw

# Integration tests drop and rebuild schemas: use a separate database whose name contains "test".
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olist_test
